# Top-level ignore rules for Agent_LLM.
# Per-app ignores live under app/.gitignore and app/src-tauri/.gitignore.

# OS metadata
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
ehthumbs_vista.db
$RECYCLE.BIN/

# Editor / IDE (project root level)
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/settings.json
!.vscode/extensions.json

# Backups / scratch
*.bak
*.tmp
*.orig
*.rej
*.swp
*.swo
/tmp/
app/tmp/

# Logs that occasionally land outside app/
*.log
logs/

# Documentation build artifacts
docs/_build/
docs/.cache/
.mypy_cache/
.ruff_cache/

# Local env / secrets
.env
.env.local
*.pem
*.key

# Build deliverables / release artifacts (use GitHub Releases instead)
deliverables/
dist/
build/

# llama.cpp prebuilt runtime (download from upstream release)
app/resources/*.dll
app/resources/*.exe
app/resources/*.lib
app/resources/*.pdb

# fast-llm 引擎与 27B 模型（体积大，仅随项目本地放置，不入库）
app/resources/fast-llm/

# Fallback ignores for app build outputs (also covered by app/.gitignore)
**/node_modules/
**/target/
**/dist/

# Local AI / editor caches
.claude/
.trae/
.opencode/
__pycache__/

# ZCode / Mimosa 工具产物
.zcode/
.mimosa/
app/.mimosa/
app/src/.mimosa/
**/.mimosa/
app/test-results/
reasonix.toml
reason/

# 本地协作工具记录
.workbuddy/
