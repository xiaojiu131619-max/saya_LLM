# Top-level ignore rules for Agent_LLM.
# Per-app ignores live under app/.gitignore and app/src-tauri/.gitignore.

# OS metadata
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
ehthumbs_vista.db
$RECYCLE.BIN/

# Editor / IDE (project root level)
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/settings.json
!.vscode/extensions.json

# Backups / scratch
*.bak
*.tmp
*.orig
*.rej
*.swp
*.swo
/tmp/
app/tmp/

# Logs that occasionally land outside app/
*.log
logs/

# Documentation build artifacts
docs/_build/
docs/.cache/
.mypy_cache/
.ruff_cache/

# Local env / secrets
.env
.env.local
*.pem
*.key

# Build deliverables / release artifacts (use GitHub Releases instead)
deliverables/
dist/
build/

# llama.cpp prebuilt runtime (download from upstream release)
app/resources/*.dll
app/resources/*.exe
app/resources/*.lib
app/resources/*.pdb

# Fallback ignores for app build outputs (also covered by app/.gitignore)
**/node_modules/
**/target/
**/dist/

# Local AI / editor caches
.claude/
.trae/
.opencode/
__pycache__/

# ZCode / Mimosa 工具产物
.zcode/
.mimosa/
app/.mimosa/
app/src/.mimosa/
**/.mimosa/
app/test-results/
reasonix.toml
reason/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
node_modules/
bower_components/
jspm_packages/
site-packages/
venv/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
# ----- ↑ 以上为 ZCode 默认排除规则（自定义规则请写在本行下方，不会被同步/恢复改动）-----
# 自定义规则写在下方（本行提示可删除）
